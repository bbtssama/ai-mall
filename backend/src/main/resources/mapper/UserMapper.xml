<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.user.mapper.UserMapper">

    <sql id="baseCols">
        id, username, password_hash, nickname, avatar, role, status, created_at
    </sql>

    <select id="selectById" resultType="com.aimall.user.bean.User">
        SELECT <include refid="baseCols"/>
        FROM t_user
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultType="com.aimall.user.bean.User">
        SELECT <include refid="baseCols"/>
        FROM t_user
        WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (username, password_hash, nickname, avatar, role, status)
        VALUES (#{username}, #{passwordHash}, #{nickname}, #{avatar}, #{role}, #{status})
    </insert>

</mapper>