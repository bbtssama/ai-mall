<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.goods.mapper.ProductSkuMapper">

    <sql id="baseCols">
        id, product_id, sku_name, price, stock, sales, version, created_at
    </sql>

    <select id="selectById" resultType="com.aimall.goods.bean.ProductSku">
        SELECT <include refid="baseCols"/>
        FROM t_product_sku
        WHERE id = #{id}
    </select>

    <select id="selectByProductId" resultType="com.aimall.goods.bean.ProductSku">
        SELECT <include refid="baseCols"/>
        FROM t_product_sku
        WHERE product_id = #{productId}
    </select>

    <select id="selectByIds" resultType="com.aimall.goods.bean.ProductSku">
        SELECT <include refid="baseCols"/>
        FROM t_product_sku
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- CAS 扣减：InnoDB 对 id 命中行加排他锁后执行 stock>=? 判断，保证不超卖；影响行数 0 = 库存不足（注意：本 SQL 未使用 version 字段） -->
    <update id="deductStock">
        UPDATE t_product_sku
        SET stock = stock - #{quantity},
            sales = sales + #{quantity}
        WHERE id = #{id} AND stock >= #{quantity}
    </update>

    <!-- 回补库存（取消订单等场景） -->
    <update id="addStock">
        UPDATE t_product_sku
        SET stock = stock + #{quantity}
        WHERE id = #{id}
    </update>

</mapper>