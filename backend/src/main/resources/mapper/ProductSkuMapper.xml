<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.goods.mapper.ProductSkuMapper">

    <sql id="baseCols">
        id, product_id, sku_name, price, stock, sales, image, version, created_at
    </sql>

    <select id="selectById" resultType="com.aimall.goods.bean.ProductSku">
        SELECT <include refid="baseCols"/>
        FROM t_product_sku
        WHERE id = #{id}
    </select>

    <select id="selectByProductId" resultType="com.aimall.goods.bean.ProductSku">
        SELECT <include refid="baseCols"/>
        FROM t_product_sku
        WHERE product_id = #{productId}
    </select>

    <select id="selectByIds" resultType="com.aimall.goods.bean.ProductSku">
        SELECT <include refid="baseCols"/>
        FROM t_product_sku
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- CAS 扣减：InnoDB 对 id 命中行加排他锁后执行 stock>=? 判断，保证不超卖；影响行数 0 = 库存不足（注意：本 SQL 未使用 version 字段）
         并发说明：其他线程的 UPDATE 会阻塞等待此 X 锁（默认最多 innodb_lock_wait_timeout=50s），拿到锁后再按最新库存判断 stock>=?。
         锁持有范围：本语句到所在事务 COMMIT 之间（含后续写订单/明细/清购物车）均持有该热点行锁；
         若要进一步缩短锁时长，应将扣库存拆为独立短事务，或引入 Redis 预扣。 -->
    <update id="deductStock">
        UPDATE t_product_sku
        SET stock = stock - #{quantity},
            sales = sales + #{quantity}
        WHERE id = #{id} AND stock >= #{quantity}
    </update>

    <!-- 回补库存（取消订单等场景） -->
    <update id="addStock">
        UPDATE t_product_sku
        SET stock = stock + #{quantity}
        WHERE id = #{id}
    </update>

</mapper>