<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.aimall</groupId>
    <artifactId>ai-mall-backend</artifactId>
    <version>1.0.0</version>
    <name>ai-mall-backend</name>
    <description>AI 种草商城后端 V1 MVP：单体跑通 浏览商品 -> 加购 -> 下单 -> AI 问答</description>

    <properties>
        <java.version>17</java.version>
        <mybatis.version>3.0.4</mybatis.version>
        <sa-token.version>1.39.0</sa-token.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <minio.version>8.5.17</minio.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：统一管理 spring-ai-starter-model-openai 等 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ORM：MyBatis（XML 手写 SQL，SQL 可见可控、便于优化，面试可讲） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 认证：Sa-Token（无状态，token 即登录态） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- 密码加密：仅引 crypto 模块，不引入完整 Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ===== V1.5 工程基建（不引入新中间件，补齐"能上线"所需能力） ===== -->

        <!-- 数据库版本管理：表结构变更纳入版本控制，多人协作/多环境不再靠手动执行 SQL。
             版本由 Spring Boot BOM 统一管理（与 Boot 3.4.5 的 FlywayAutoConfiguration 匹配）。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 可观测性：健康检查 / 指标 / 优雅下线等生产运维端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 对象存储：MinIO（S3 兼容）。注意——本项目【不强制依赖】它：
             未配置 MinIO 时自动回退本地文件存储，保证任何环境都能正常启动。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <!-- ===== V2：RabbitMQ（AI 内容审核异步化） =====
             为什么需要 MQ：AI 审核要 3~10 秒，不能让用户点"发布"后干等——
             发布秒回（状态=AUDITING），审核走 MQ 异步回写。
             同样不强制依赖：未启动 RabbitMQ 时自动降级为线程池异步审核。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ===== V3：Redis（缓存 / 计数 / 排行榜 / 分布式锁 / 限流） =====
             为什么需要：商品详情读多写少、笔记点赞是热点写、热门榜要实时排序。
             同样不强制依赖：Redis 未启动时 Redis 调用统一降级走 DB，应用照常运行。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- AI：Spring AI 以 OpenAI 兼容模式接入 DeepSeek（base-url 指向 api.deepseek.com） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 语音引擎：纯 Java Edge-TTS（tts-edge-java，MIT，内置 Sec-MS-GEC 令牌无需 key）。
             独立包 com.aimall.voice 使用；仅作为「派蒙 6k VITS」主路径不可用时的本地兜底。
             ★主路径 = 本机内嵌 VITS（127.0.0.1:9944），由 VitsLifecycle 随后端启动自动拉起
             voice-tts/vits_server.py；缺 Python/模型/依赖时才回退本 Edge-TTS（见 VoiceEngineImpl）。
             与 PaimonLiveWeb5 后端同款、依赖已缓存，勿升级到不含 403 修复的旧版。 -->
        <dependency>
            <groupId>io.github.whitemagic2014</groupId>
            <artifactId>tts-edge-java</artifactId>
            <version>1.3.3</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 阿里云镜像加速依赖下载（仅对本项目生效） -->
    <repositories>
        <repository>
            <id>aliyun-central</id>
            <url>https://maven.aliyun.com/repository/central</url>
        </repository>
        <repository>
            <id>aliyun-spring</id>
            <url>https://maven.aliyun.com/repository/spring</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>